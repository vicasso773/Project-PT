# Copy this file to .env.local and fill in what you have.
# Every key is optional: anything missing shows up on reports as "Couldn't check", never as a fail.

# Google PageSpeed Insights (speed + mobile checks). Free.
# Get it: console.cloud.google.com → APIs & Services → Credentials → Create credentials → API key,
# then enable "PageSpeed Insights API" in the API Library.
PAGESPEED_API_KEY=

# Google Places API (rating, reviews, hours, phone; name/address/phone match check; "no website" mode).
# Same Google Cloud project: enable "Places API (New)". Needs billing turned on (Google gives a monthly free credit).
GOOGLE_PLACES_API_KEY=

# Database (saved, shareable reports). Locally this SQLite file is created for you.
DATABASE_URL="file:./dev.db"

# Optional: "Save as lead" button → Airtable
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=

# Optional: the public address of this app, used in share links and QR codes.
# Leave blank and it's detected automatically (works on Vercel).
PUBLIC_BASE_URL=
